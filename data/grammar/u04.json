    {"type": "gap", "q": "Yo ___ los deberes por la noche.", "hint": "hacer", "a": "hago", "en": "I do the homework at night.", "tags": ["yo-irregular"]},
    {"type": "gap", "q": "¿___ (yo) pagar con tarjeta?", "hint": "poder", "a": "puedo", "en": "Can I pay by card?", "tags": ["o-ue"]},
