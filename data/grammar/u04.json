    {"type": "table", "verb": "querer", "tags": ["e-ie"]},
    {"type": "table", "verb": "ir", "tags": ["ir"]},
    {"type": "table", "verb": "hacer", "tags": ["yo-irregular"]},
    {"type": "table", "verb": "pedir", "tags": ["e-i"]},
