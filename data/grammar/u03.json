{
  "id": "u03",
  "n": 3,
  "level": "A1",
  "title": "Present tense: regular verbs",
  "summary": "-ar, -er and -ir verbs for everything you do now and usually.",
  "explain": [
    {"h": "Three groups"},
    {"p": "Every infinitive ends in **-ar**, **-er** or **-ir**. Take off the ending and add the ending for the person."},
    {"table": [["", "hablar", "comer", "vivir"], ["yo", "hablo", "como", "vivo"], ["tú", "hablas", "comes", "vives"], ["él / ella / usted", "habla", "come", "vive"], ["nosotros", "hablamos", "comemos", "vivimos"], ["vosotros", "habláis", "coméis", "vivís"], ["ellos / ustedes", "hablan", "comen", "viven"]], "head": true},
    {"p": "-er and -ir verbs share all endings except **nosotros** (*-emos / -imos*) and **vosotros** (*-éis / -ís*)."},
    {"h": "When to use it"},
    {"p": "The present covers what you do **now**, what you do **usually**, and fixed plans for the **near future**."},
    {"ex": ["Trabajo en una empresa de ventanas.", "I work in a window company."]},
    {"ex": ["Los lunes llamamos a los proveedores.", "On Mondays we call the suppliers."]},
    {"ex": ["Mañana instalamos las puertas.", "Tomorrow we're installing the doors."]},
    {"tip": "The accent in *habláis, coméis, vivís* is part of the spelling. Without it the answer counts only half."}
  ],
  "exercises": [
    {"type": "table", "verb": "trabajar", "tags": ["ar"]},
    {"type": "table", "verb": "comer", "tags": ["er"]},
    {"type": "table", "verb": "escribir", "tags": ["ir"]},
    {"type": "table", "verb": "necesitar", "tags": ["ar"]},
    {"type": "table", "verb": "vender", "tags": ["er"]},
    {"type": "table", "verb": "abrir", "tags": ["ir"]},
    {"type": "gap", "q": "Yo ___ en una empresa de construcción.", "hint": "trabajar", "a": "trabajo", "en": "I work in a construction company.", "tags": ["ar", "p-yo"]},
    {"type": "gap", "q": "¿Tú ___ inglés?", "hint": "hablar", "a": "hablas", "en": "Do you speak English?", "tags": ["ar", "p-tu"]},
    {"type": "gap", "q": "El cliente ___ la factura hoy.", "hint": "pagar", "a": "paga", "en": "The client pays the invoice today.", "tags": ["ar", "p-el"]},
    {"type": "gap", "q": "Nosotros ___ las ventanas el lunes.", "hint": "instalar", "a": "instalamos", "en": "We install the windows on Monday.", "tags": ["ar", "p-nos"]},
    {"type": "gap", "q": "¿Vosotros ___ a las dos?", "hint": "comer", "a": "coméis", "en": "Do you (all) eat at two?", "tags": ["er", "p-vos"]},
    {"type": "gap", "q": "Ellos ___ en Valencia.", "hint": "vivir", "a": "viven", "en": "They live in Valencia.", "tags": ["ir", "p-ellos"]},
    {"type": "gap", "q": "Mi novia ___ el periódico cada mañana.", "hint": "leer", "a": "lee", "en": "My girlfriend reads the newspaper every morning.", "tags": ["er", "p-el"]},
    {"type": "gap", "q": "Nosotros ___ en un piso pequeño.", "hint": "vivir", "a": "vivimos", "en": "We live in a small flat.", "tags": ["ir", "p-nos"]},
    {"type": "gap", "q": "Yo ___ muchos correos.", "hint": "recibir", "a": "recibo", "en": "I receive a lot of emails.", "tags": ["ir", "p-yo"]},
    {"type": "gap", "q": "¿Ustedes ___ con tarjeta?", "hint": "pagar", "a": "pagan", "en": "Are you paying by card?", "tags": ["ar", "p-ellos", "usted"]},
    {"type": "gap", "q": "Vosotros ___ mucho.", "hint": "trabajar", "a": "trabajáis", "en": "You (all) work a lot.", "tags": ["ar", "p-vos"]},
    {"type": "choice", "q": "Nosotros ___ en Madrid.", "options": ["vivemos", "vivimos"], "a": 1, "why": "-ir verbs: nosotros ends in -imos.", "tags": ["ir", "p-nos"]},
    {"type": "choice", "q": "Ellos ___ café.", "options": ["beben", "biben"], "a": 0, "tags": ["er", "p-ellos"]},
    {"type": "error", "q": "Yo hablas español.", "a": "Yo hablo español.", "why": "yo → -o.", "tags": ["ar", "p-yo"]},
    {"type": "error", "q": "Nosotros comimos a las dos todos los días.", "a": "Nosotros comemos a las dos todos los días.", "why": "-er verbs: nosotros ends in -emos (comimos is the past).", "tags": ["er", "p-nos"]},
    {"type": "transform", "instr": "Change to nosotros.", "q": "Trabajo en la obra.", "a": "Trabajamos en la obra.", "tags": ["ar", "p-nos"]},
    {"type": "transform", "instr": "Change to ellos.", "q": "Vende ventanas.", "a": "Venden ventanas.", "tags": ["er", "p-ellos"]},
    {"type": "translate", "q": "We need more screws.", "a": "Necesitamos más tornillos", "tags": ["ar", "p-nos"]},
    {"type": "translate", "q": "Do you live here? (tú)", "a": "¿Vives aquí?", "tags": ["ir", "p-tu"]},
    {"type": "reorder", "words": ["El", "proveedor", "envía", "el", "pedido", "mañana"], "a": "El proveedor envía el pedido mañana", "en": "The supplier sends the order tomorrow.", "tags": ["ar", "p-el"]}
  ]
}
